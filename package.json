{
	"name": "@watergis/maplibre-gl-terradraw",
	"displayName": "Maplibre GL Terra Draw",
	"version": "1.17.0",
	"description": "This plugin is to add controls to your Maplibre for drawing powered by Terra Draw library.",
	"type": "module",
	"main": "dist/maplibre-gl-terradraw.umd.js",
	"types": "./dist/types/index.d.ts",
	"module": "dist/maplibre-gl-terradraw.es.js",
	"exports": {
		".": {
			"types": "./dist/types/index.d.ts",
			"import": "./dist/maplibre-gl-terradraw.es.js",
			"require": "./dist/maplibre-gl-terradraw.umd.js"
		},
		"./dist/maplibre-gl-terradraw.css": {
			"import": "./dist/maplibre-gl-terradraw.css",
			"require": "./dist/maplibre-gl-terradraw.css"
		}
	},
	"files": [
		"dist",
		"!dist/**/*.test.*",
		"!dist/**/*.spec.*",
		"!dist/icons/**/*.svg"
	],
	"scripts": {
		"dev": "vite dev",
		"build": "npm run typedoc && npm run build:doc && npm run package",
		"build:doc": "vite build --config vite.config.ts",
		"preview": "vite preview",
		"package": "npm run package:js && npm run package:css",
		"package:js": "tsc --project tsconfig.lib.json && vite build --config vite.lib.config.ts",
		"package:scss": "sass --no-source-map --style=compressed src/scss/maplibre-gl-terradraw.scss:dist/maplibre-gl-terradraw.css",
		"package:postcss": "cp -r src/scss/icons dist/icons && postcss dist/*.css -r",
		"package:css": "npm run package:scss && npm run package:postcss",
		"prepublishOnly": "npm run package",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"release": "changeset publish",
		"typedoc": "typedoc",
		"typedoc:serve": "serve ./static/docs",
		"depcruise": "depcruise src/lib --include-only '^src/lib' --output-type dot | dot -T svg > dependency-graph.svg",
		"test": "npm run test:vitest && npm run test:playwright",
		"test:vitest": "vitest --run --passWithNoTests",
		"test:vitest:coverage": "vitest run --coverage",
		"test:playwright": "playwright test",
		"generate:authors": "tsx scripts/generate-example-page-authors.ts && pnpm exec prettier --write src/routes/authors.json"
	},
	"devDependencies": {
		"@changesets/cli": "^3.0.3",
		"@eslint/js": "^10.0.1",
		"@lucide/svelte": "^1.51.0",
		"@playwright/test": "^1.63.0",
		"@skeletonlabs/skeleton": "^5.0.1",
		"@skeletonlabs/skeleton-svelte": "^5.0.1",
		"@sveltejs/adapter-cloudflare": "^8.0.0",
		"@sveltejs/kit": "^3.0.0",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@tailwindcss/vite": "^4.3.3",
		"@testing-library/jest-dom": "^7.0.1",
		"@turf/area": "^7.4.0",
		"@turf/centroid": "^7.4.0",
		"@turf/distance": "^7.4.0",
		"@types/eslint": "^9.6.1",
		"@types/geojson": "^7946.0.16",
		"@types/node": "^26.6.4",
		"@undp-data/style-switcher": "^2.0.15",
		"@vitest/coverage-v8": "^5.0.3",
		"@watergis/maplibre-gl-export": "^5.0.0",
		"@watergis/terrain-rgb": "^2.1.1",
		"cssnano": "^9.2.2",
		"dependency-cruiser": "^18.5.0",
		"eslint": "^10.12.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.23.0",
		"globals": "^17.13.0",
		"jsdom": "^30.1.1",
		"lefthook": "^2.1.16",
		"maplibre-gl": "^6.12.0",
		"postcss": "^8.5.28",
		"postcss-cli": "^12.0.0",
		"postcss-url": "^10.1.4",
		"prettier": "^3.9.9",
		"prettier-plugin-svelte": "^4.1.1",
		"publint": "^0.3.25",
		"sass": "^1.105.1",
		"sass-embedded": "^1.105.1",
		"serve": "^14.2.6",
		"shiki": "^4.5.0",
		"simple-git": "^4.0.2",
		"simple-icons": "^16.34.0",
		"svelte": "^5.57.1",
		"svelte-check": "^4.7.6",
		"tailwindcss": "^4.3.3",
		"terra-draw": "^1.36.0",
		"terra-draw-maplibre-gl-adapter": "^1.4.1",
		"tsx": "^4.23.15",
		"typedoc": "^0.28.20",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.71.0",
		"vite": "^8.3.2",
		"vitest": "^5.0.3",
		"wrangler": "^4.147.0"
	},
	"peerDependencies": {
		"maplibre-gl": "^4.0.0 || ^5.0.0 || ^6.0.0",
		"terra-draw": "^1.0.0",
		"terra-draw-maplibre-gl-adapter": "^1.0.0"
	},
	"peerDependenciesMeta": {
		"terradraw": {
			"optional": true
		},
		"terra-draw-maplibre-gl-adapter": {
			"optional": true
		}
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/watergis/maplibre-gl-terradraw.git"
	},
	"keywords": [
		"maplibre-gl-js",
		"terra-draw",
		"drawing"
	],
	"author": {
		"name": "Jin Igarashi",
		"url": "https://jin-igarashi.me"
	},
	"license": "MIT",
	"bugs": {
		"url": "https://github.com/watergis/maplibre-gl-terradraw/issues"
	},
	"homepage": "https://github.com/watergis/maplibre-gl-terradraw#readme",
	"packageManager": "pnpm@12.9.1",
	"engines": {
		"pnpm": "^12.0.0"
	},
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	}
}
