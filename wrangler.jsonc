{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "maplibre-gl-terradraw",
	"compatibility_date": "2026-05-30",
	"compatibility_flags": ["nodejs_compat"],
	"main": ".svelte-kit/cloudflare/_worker.js",
	"assets": {
		"binding": "ASSETS",
		"directory": ".svelte-kit/cloudflare",
		// The typedoc API docs under /docs are plain static HTML. They must be served by the
		// asset layer directly: it rewrites `foo.html` to the extensionless `/foo`, which the
		// SvelteKit worker does not recognise as an asset and would answer with a 404.
		"run_worker_first": ["/*", "!/docs", "!/docs/*"]
	},
	"workers_dev": true,
	"preview_urls": true,
	"observability": {
		"enabled": true
	}
}
